t = "..."/>			<Cmd command = "StartDialog" actor = "Vascolet" text = "No parece malvado..."/>			<Cmd command = "StartDialog" actor = "Vascolet" text = "A lo mejor puedo encontrar algo que lo reanime..."/>			<Cmd command = "StartDialog" actor = "Vascolet" text = "Será mejor que comience a buscar."/>		-->			</Steps>				<FinalActions>			<ForceState actor = "Vascolet" state = "stand"/>			<ForceState actor = "Willy" state = "normal"/>		</FinalActions>		</Scene>		<Scene name = "VascoletAndWillyWithoutItem" restarts="yes" centerCamera="yes" >		<StartConditions>			<TryToTalk with = "Willy"/>			<ItemCond itemType = "VascoletForDragons" count = "0" />		</StartConditions>				<StartActions>			<ForceState actor = "Vascolet" state = "Acting"/>			<ForceState actor = "Willy" state = "Acting"/>		</StartActions>				<Steps>			<Cmd command = "FacingToOther" actor = "Vascolet" other = "Willy"/>			<Cmd command = "Act" actor = "Vascolet" anim = "Thinking"/>			<Cmd command = "StartDialog" actor = "Vascolet" text = "Será mejor que busque algo para reanimar a este dragón..."/>		</Steps>				<FinalActions>			<ForceState actor = "Vascolet" state = "Stand"/>			<ForceState actor = "Willy" state = "Normal"/>		</FinalActions>	</Scene>		<Scene name = "VascoletAndWillyWithItem" restarts="no" centerCamera="yes" >				<StartConditions>			<TryToTalk with = "Willy"/>			<ItemCond itemType = "VascoletForDragons" count = "1" />		</StartConditions>				<DiscardedScenes>			<Scene name = "VascoletAndWillyWithoutItem"/>		</DiscardedScenes>				<StartActions>			<ConsumeItem itemType="VascoletForDragons" count="1" />			<ForceState actor = "Vascolet" state = "Acting"/>			<ForceState actor = "Willy" state = "Acting"/>		</StartActions>				<Steps>			<Cmd command = "FacingToOther" actor = "Vascolet" other = "Willy"/>			<Cmd command = "Act" actor = "Vascolet" anim = "Thinking"/>			<Cmd command = "StartDialog" actor = "Vascolet" text = "A lo mejor, si le doy este 